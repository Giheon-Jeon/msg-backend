[Unit]
Description=MSG backend instance history reconciliation
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/msg-dev
ExecStart=/usr/bin/docker compose --project-name msg-dev --file /opt/msg-dev/compose.yml --env-file /opt/msg-dev/.env exec -T backend python manage.py reconcile_instances --batch-size 100 --max-seconds 20
TimeoutStartSec=45
