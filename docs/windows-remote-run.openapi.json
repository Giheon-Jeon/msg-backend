{
  "openapi": "3.1.0",
  "info": {
    "title": "Windows remote execution backend boundary",
    "version": "1.0.0",
    "description": "Backend API candidate; actual Azure, Scheduler guest readiness and checker provider integration are pending. No execution quota; per-team request interval only."
  },
  "paths": {
    "/api/v1/challenges/{challenge_id}/exe-submissions": {
      "get": {
        "security": [
          {
            "UserToken": []
          }
        ],
