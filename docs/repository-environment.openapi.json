  "components": {
    "securitySchemes": {
      "admin_bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "ADMIN role required"
      }
    },
    "schemas": {
      "SourceEnvelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "container",
              "source_revision",
              "source_url",
              "source_token",
              "entries",
              "warnings",
              "build_context",
              "source_files"
            ],
            "properties": {
              "container": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              },
              "source_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "source_token": {
                "type": "string"
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "kind",
                    "required",
                    "selected",
                    "has_value",
                    "needs_value",
                    "locked_secret",
                    "use_existing",
                    "secret_name",
                    "sources",
                    "resolution"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "env",
                        "secret"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "selected": {
                      "type": "boolean"
                    },
                    "has_value": {
                      "type": "boolean"
                    },
                    "needs_value": {
                      "type": "boolean"
                    },
                    "locked_secret": {
                      "type": "boolean"
                    },
                    "use_existing": {
                      "type": "boolean"
                    },
                    "secret_name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    },
                    "secret_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "value": {
                      "type": "string",
                      "description": "Included only for ordinary configuration; secret values are omitted."
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "line",
                          "origin"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "line": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 1
                          },
                          "origin": {
                            "type": "string",
                            "enum": [
                              "dockerfile",
                              "compose",
                              "env_file",
                              "env_example",
                              "source"
                            ]
                          }
                        }
                      }
                    },
                    "resolution": {
                      "type": "string",
                      "enum": [
                        "configured",
                        "code_default",
                        "author_example",
                        "needs_value",
                        "conflict"
                      ]
                    }
                  }
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "build_context": {
                "type": "string"
              },
              "source_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PreviewRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "container",
          "source_token",
          "entries"
        ],
        "properties": {
          "container": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "source_token": {
            "type": "string",
            "maxLength": 2048
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "environment-file.openapi.json#/components/schemas/Entry"
            }
          },
          "overrides": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "description": "Literal UTF-8 string, at most 4096 bytes; no CR, LF or NUL."
            }
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ImportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "container",
          "source_token",
          "entries",
          "request_id"
        ],
        "properties": {
          "container": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "source_token": {
            "type": "string",
            "maxLength": 2048
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "environment-file.openapi.json#/components/schemas/Entry"
            }
          },
          "overrides": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "description": "Literal UTF-8 string, at most 4096 bytes; no CR, LF or NUL."
            }
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PreviewEnvelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "container",
              "entries",
              "errors",
              "preserved_names",
              "other_containers",
              "can_import",
              "source_revision"
            ],
            "properties": {
              "container": {
                "type": "string"
              },
              "entries": {
                "type": "array",
                "items": {
                  "$ref": "environment-file.openapi.json#/components/schemas/PreviewRow"
                }
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "preserved_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "other_containers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "can_import": {
                "type": "boolean"
              },
              "source_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    }
  }
}
