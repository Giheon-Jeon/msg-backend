{
  "openapi": "3.1.0",
  "info": {
    "title": "MSG CTF author environment import",
    "version": "1.2.0",
    "description": "Read env/{container}.env as the runtime source at a pinned commit, with legacy discovery only when it is absent. Secret values remain on the server and are encrypted on import. Allows up to 128 injected variables per container."
  },
