{
  "openapi": "3.1.0",
  "info": {
    "title": "MSG KOTH approved image transfer",
    "version": "1.0.0"
  },
  "paths": {
    "/internal/v1/koth_environments/{challenge_id}/image_export": {
      "post": {
        "security": [
          {
            "agent_bearer": []
          }
        ],
        "parameters": [
          {
            "name": "challenge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "application_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "version_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "image_ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "application_id",
                  "version_id",
                  "image_ref"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A ticket for the current approved image",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "ticket": {
                          "type": "string"
                        },
                        "image_ref": {
                          "type": "string"
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "url",
                        "ticket",
                        "image_ref",
                        "expires_at"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/koth_image_exports": {
      "post": {
        "security": [
          {
            "image_ticket": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "image_ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "image_ref"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified OCI archive",
            "headers": {
              "X-Content-SHA256": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/x-tar": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "agent_bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "image_ticket": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
