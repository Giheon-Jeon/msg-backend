{
  "openapi": "3.0.3",
  "info": { "title": "Team payment QR", "version": "1.2.0" },
  "paths": {
    "/api/v1/teams/me/qr_token": {
      "post": {
        "summary": "현재 팀의 결제 QR 발급",
        "description": "team_id는 실제로 저장한 결제 토큰의 소유 팀이다 발급 전후 소속이 바뀌어도 응답을 나중에 조회한 소속으로 덮어쓰지 않는다 프론트는 현재 화면의 팀과 다르면 QR을 표시하지 않는다 발급은 팀 잠금 뒤 DB의 소속을 다시 확인하며 대기 중 팀에서 제외됐거나 다른 팀으로 옮겨졌으면 발급하지 않는다 팀원 제외가 커밋되면 해당 팀의 모든 ACTIVE QR은 INVALIDATED가 되며 재배정돼도 되살아나지 않는다 이름·팀장 변경과 팀원 추가만으로는 QR을 폐기하지 않는다",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "발급 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code", "data"],
                  "properties": {
                    "code": { "type": "string" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "required": ["team_id", "payment_token", "expires_at"],
                      "properties": {
                        "team_id": { "type": "string", "format": "uuid" },
                        "payment_token": { "type": "string", "minLength": 1 },
                        "expires_at": { "type": "string", "format": "date-time" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "잠금 대기 중 다른 팀으로 변경됨 INVALID_REQUEST" },
          "401": { "description": "인증 필요" },
          "403": { "description": "밴된 팀은 발급 불가" },
          "404": { "description": "소속 팀 없음" }
        }
      }
    },
    "/api/v1/admin/payment/checkout": {
      "post": {
        "summary": "QR 결제 승인",
        "description": "관리자 전용이며 팀과 QR을 잠근 뒤 검사 시점이 expires_at 이상이면 거절한다 같은 QR은 한 번만 결제할 수 있고 재요청은 PAYMENT_TOKEN_INVALID로 거절하며 추가로 차감하지 않는다 팀원 제외가 먼저 커밋됐으면 이전 QR로 결제할 수 없다 결제가 먼저 확정됐다면 그 차감과 USED QR 및 거래 내역은 이후 팀원 제외에도 보존한다",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["payment_token", "amount", "item_name"],
                "properties": {
                  "payment_token": { "type": "string", "minLength": 1 },
                  "amount": { "type": "integer", "minimum": 1 },
                  "item_name": { "type": "string", "minLength": 1, "maxLength": 100 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "결제와 잔액 및 거래 내역이 한 트랜잭션으로 반영됨" },
          "400": { "description": "PAYMENT_TOKEN_INVALID 또는 PAYMENT_TOKEN_EXPIRED 또는 요청 값·잔액 오류 추가 차감 없음" },
          "401": { "description": "인증 필요" },
          "403": { "description": "관리자 권한 없음 또는 밴된 팀" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  }
}
