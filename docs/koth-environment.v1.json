  "paths": {
    "/api/v1/admin/koth/challenges/{challenge_id}/environment": {
      "get": {
        "security": [
          {
            "admin_jwt": []
          }
        ],
        "parameters": [
          {
            "name": "challenge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "const": "SUCCESS"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/admin_settings"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid credential"
          },
          "403": {
            "description": "Administrator permission required"
          },
          "409": {
            "description": "Stale, active or superseded request"
          },
          "503": {
            "description": "Secret storage or repository unavailable"
          }
        }
      }
    },
